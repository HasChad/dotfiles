// Zed Settings
// https://zed.dev/docs/configuring-zed

{
    "minimap": {
        "show": "always",
    },
    "theme": "GitHub Dark",
    "icon_theme": "Material Icon Theme",

    "buffer_font_family": "Monaspace Krypton",
    "buffer_line_height": "standard",
    "buffer_font_size": 14.0,
    "ui_font_family": ".SystemUIFont",
    "ui_font_size": 16,

    "colorize_brackets": true,
    "format_on_save": "on",
    "tab_size": 4,
    "show_wrap_guides": true,
    "wrap_guides": [100],

    "diagnostics": {
        "inline": {
            "enabled": true,
            "max_severity": null,
        },
    },

    "tabs": {
        "file_icons": true,
        "show_diagnostics": "all",
    },
    "toolbar": {
        "breadcrumbs": false,
        "quick_actions": false,
    },
    "project_panel": {
        "dock": "left",
    },
    "git_panel": {
        "dock": "left",
    },
    "title_bar": {
        "show_menus": false, // change to true when they fix the titlebar
        "show_branch_name": false,
        "show_project_items": false,
    },

    "disable_ai": true,
    "telemetry": {
        "diagnostics": false,
        "metrics": false,
    },
}
