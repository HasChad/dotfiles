custom-shader = ~/.config/ghostty/cursor_trail.glsl

# Keybinds
keybind = alt+h=goto_split:up
keybind = alt+j=goto_split:down
keybind = alt+k=goto_split:left
keybind = alt+l=goto_split:right

keybind = ctrl+alt+h=new_split:up
keybind = ctrl+alt+j=new_split:down
keybind = ctrl+alt+k=new_split:left
keybind = ctrl+alt+l=new_split:right

keybind = shift+alt+h=resize_split:up,10
keybind = shift+alt+j=resize_split:down,10
keybind = shift+alt+k=resize_split:left,50
keybind = shift+alt+l=resize_split:right,50

# Window
window-width = 100
window-height = 25
window-padding-x = 3
window-padding-y = 0

# Background
background = 000000
background-opacity = 0.9
background-blur = false

# Scrolling
scrollback-limit = 10000
mouse-scroll-multiplier = 3

# Font
font-size = 11
font-family = "Monaspace Krypton"
font-style = "Medium"
font-family-bold = "Monaspace Krypton"
font-style-bold = "Bold"
font-family-italic = "Monaspace Krypton"
font-style-italic = "Medium Italic"
font-family-bold-italic = "Monaspace Krypton"
font-style-bold-italic = "Bold Italic"
adjust-cell-height = -1

# Cursor
shell-integration-features = no-cursor
cursor-style = block
cursor-style-blink = true

# Mouse
mouse-hide-while-typing = true
