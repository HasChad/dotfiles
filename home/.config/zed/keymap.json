// Zed Keymap
// https://zed.dev/docs/key-bindings

[
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
    }
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      // "j k": "vim::NormalBefore"
    }
  },
  {
    "context": "(Workspace && debugger_stopped)",
    "bindings": {
      "alt-t": "debugger::Continue"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "alt-t": "debugger::Rerun"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "f5": [
        "task::Rerun",
        {
          "reevaluate_context": true
        }
      ]
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "alt-f5": "task::Spawn"
    }
  },
  {
    "context": "(Workspace && debugger_stopped)",
    "bindings": {
      "f5": null
    }
  }
]
