{
  "logo": {
    "type": "none",
  },
  "modules": [
    // Hardware
    {
      "type": "host",
      "key": " PC",
      "keyColor": "green",
    },
    {
      "type": "cpu",
      "key": "  ├ ",
      "keyColor": "green",
    },
    {
      "type": "gpu",
      "key": "  ├󰍛 ",
      "keyColor": "green",
    },
    {
      "type": "memory",
      "key": "  ├ ",
      "keyColor": "green",
    },
    {
      "type": "disk",
      "key": "  └ ",
      "keyColor": "green",
    },
    "break",
    // Software

    {
      "type": "os",
      "key": " OS",
      "keyColor": "yellow",
    },
    {
      "type": "kernel",
      "key": "  ├ ",
      "keyColor": "yellow",
    },
    {
      "type": "packages",
      "key": "  ├󰏖 ",
      "keyColor": "yellow",
    },
    {
      "type": "shell",
      "key": "  └ ",
      "keyColor": "yellow",
    },
    "break",
    // Desktop Environment
    {
      "type": "de",
      "key": " DE",
      "keyColor": "blue",
    },
    {
      "type": "lm",
      "key": "  ├ ",
      "keyColor": "blue",
    },
    {
      "type": "wm",
      "key": "  ├ ",
      "keyColor": "blue",
    },
    {
      "type": "wmtheme",
      "key": "  ├󰉼 ",
      "keyColor": "blue",
    },
    {
      "type": "terminal",
      "key": "  └ ",
      "keyColor": "blue",
    },
    "break",
    // Time
    {
      "type": "command",
      "key": " OS Age",
      "keyColor": "magenta",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days",
    },
    {
      "type": "uptime",
      "key": " Uptime",
      "keyColor": "magenta",
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle",
    },
  ],
}
